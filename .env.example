# Gemini API
GOOGLE_API_KEY=your_gemini_api_key

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key

# Cloudflare Pages 배포
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_PAGES_PROJECT=your_pages_project

# Tistory
TISTORY_APP_ID=your_app_id
TISTORY_SECRET_KEY=your_secret_key
TISTORY_ACCESS_TOKEN=your_access_token
TISTORY_BLOG_NAME=your_blog_name
TISTORY_ENABLED=true

# Twitter/X (Phase 2)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_ENABLED=false

# Instagram (Phase 2)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ENABLED=false

# YouTube (Phase 3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ENABLED=false

# Schedule (KST)
PUBLISH_SCHEDULE_HOUR=9
PUBLISH_SCHEDULE_MINUTE=0
CONTENT_NICHE=투자/재테크

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ENABLED=false

# Instagram Graph API
META_ACCESS_TOKEN=
IG_USER_ID=
IG_REELS_ENABLED=false
INSTAGRAM_VIDEO_HOST_URL=

# Discord 알림 웹훅
DISCORD_WEBHOOK_URL=

# LLM 분석 모델 (기본값: Gemini Pro)
ANALYSIS_MODEL=google/gemini-2.5-pro-exp-0325:free

# 1차 LLM 백엔드 (agy | claude | ollama). gemini 는 2026-09 지원 종료로 제외
LLM_PRIMARY_BACKEND=agy

# 폴백 순서 (콤마 구분). 앞에서부터 시도하고 실패하면 다음으로 넘어간다
LLM_BACKENDS_OVERRIDE=agy,claude,ollama

# agy 모델. 비우면 agy 기본값을 쓴다 — 붙어 있는 모델이 환경마다 다르므로
# (Gemini 3.7 Flash / Claude Opus 4.6 등) 고정하지 않는 것을 권장한다.
# 지정하려면 `agy --model x -p y` 로 먼저 인식되는 이름인지 확인할 것
AGY_MODEL=

# Gemini CLI 모델 — 지원 종료. 폴백에서 뺐지만 코드 경로는 남아 있다
GEMINI_CLI_MODEL=gemini-2.5-flash

# Ollama 로컬 모델
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_TIMEOUT_SEC=300
OLLAMA_THINK_MODE=script

# Codex 모델
CODEX_MODEL=gpt-5.4-mini

# 영상 LLM 최적화 (OpenRouter HTTP 기반 고속 모델)
VIDEO_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
VIDEO_LLM_TIMEOUT_SEC=60
LLM_VIDEO_BACKEND=openrouter

# 영상 빌드 속도 최적화
SKIP_LONG_VIDEO=false
SHORT_DURATION_SEC=30
KENBURNS_PER_CHART_SEC=2

# 스크립트 강제 재생성
FORCE_REGEN_SCRIPT=false

# FFmpeg 영상 인코딩 설정
FFMPEG_VIDEO_CODEC=h264_nvenc
FFMPEG_PRESET=p1

# Video branding (Improvement 4)
VIDEO_BRANDING=1            # 인트로/아웃트로 카드 (default on)
VIDEO_LOWER_THIRD=1         # 챕터 제목 lower-third 오버레이 (default on)
BLOG_URL_HINT=investiqs.net # 아웃트로 CTA URL

# Motion graphics (Improvement 3)
VIDEO_ANIMATED_CARDS=1      # 카운트업/타이프라이터 애니메이션 (default on)

# BGM (배경음악)
VIDEO_BGM=1                 # BGM 활성화 (default on)
BGM_VOLUME=0.08             # 나레이션 대비 볼륨 (0.0~1.0, 기본 0.08)
BGM_CACHE_DIR=.omc/bgm_cache  # 로컬 MP3 캐시 디렉토리

# Bridge API
# BRIDGE_PORT=8765
# BRIDGE_BIND_HOST: 172.17.0.1 to allow Docker n8n container to reach; 127.0.0.1 = host-only (default)
BRIDGE_BIND_HOST=172.17.0.1
# BRIDGE_TOKEN=<secret>  # uncomment + set to require Bearer auth on all non-/health endpoints

# Paperclip → Blog 통합 (n8n cron 60min 폴링 + HugoPublisher 발행)
# PAPERCLIP_API_BASE=http://127.0.0.1:3100
# PAPERCLIP_COMPANY_ID=ccd0c00a-d565-4fc4-910f-9d823665313b  # NichProject 회사 UUID
# PAPERCLIP_API_KEY=<bearer>  # authenticated 모드 전환 시 필요
PAPERCLIP_PUBLISH_ENABLED=0     # 0=비활성, 1=활성 (opt-in master switch)
PAPERCLIP_PUBLISH_DRY_RUN=0     # 1=검증만 (Hugo 호출 skip)
PAPERCLIP_PUBLISH_COMPLIANCE=1  # 1=compliance check 강제
PAPERCLIP_PUBLISH_SEO=1         # 1=seo_validator hard 미통과 시 skip
PAPERCLIP_PUBLISH_DAILY_LIMIT=3 # paperclip source 일별 발행 상한
