# 환경변수 / 시크릿
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
ml_env/

# OMC / Claude 내부 상태
.omc/state/
.omc/sessions/
.claude/scheduled_tasks.lock
web/public/.omc/
# web/ 안에서 hugo 를 돌리면 여기에도 상태가 쌓인다 (2026-08-23)
web/.omc/
# 영상 캐시 — 편당 수십 MB, 재생성 가능
.omc/video_cache/
.omc/script_cache/
# 잘못된 경로로 만들어진 산출물
web/web/
web/public_adsense/

# 빌드 산출물
web/public/
web/content/en/daily/

# 빌드 / 로그
*.log
auto_publisher/*.log
n8n/bridge.log

# OAuth 자격증명 — 절대 커밋 금지 (2026-08-08)
.youtube_secrets/
